# GeoAI Portal settings.
#   1. Copy this file to .env        (cp .env.example .env)
#   2. Change the passwords below
#   3. docker compose up -d
# Never commit or share .env: it holds your passwords.

# ---------------------------------------------------------------------------
# Where people open the portal
# ---------------------------------------------------------------------------
# Port on this machine. Pick another one if 8080 is already in use.
GEOAI_PORT=8080
# The full address people type in their browser. Keep the port the same as GEOAI_PORT.
# With a domain name and HTTPS in front, for example: https://maps.example.org
# Decide this before the first start: Keycloak remembers it.
GEOAI_PUBLIC_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Passwords. Use long random values without ";".
# They are stored on the first start, so change them BEFORE the first "docker compose up".
# ---------------------------------------------------------------------------
# Portal database, user "geoai".
POSTGRES_PASSWORD=change-me
# Keycloak's own database, user "keycloak".
KEYCLOAK_DB_PASSWORD=change-me-too
# Keycloak admin console (<GEOAI_PUBLIC_URL>/auth/admin). Only for managing Keycloak itself.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-as-well
# Lets the API manage accounts in Keycloak: the first administrator, and everyone on Settings > People.
GEOAI_KEYCLOAK_CLIENT_SECRET=change-me-secret

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Version of the geoaiportal/api and geoaiportal/client images on Docker Hub: latest, or pin one, for
# example 1 (every 1.x.y), 1.0 (every 1.0.x) or an exact 1.0.4. Pin a version on servers that should not
# change on their own.
GEOAI_VERSION=latest
# true when nginx, Traefik or another reverse proxy handles HTTPS in front of the portal.
GEOAI_BEHIND_PROXY=false
# Largest file people may upload, in MB.
GEOAI_MAX_UPLOAD_MB=512
# How many imports run at the same time, and how long one may take.
GEOAI_IMPORT_WORKERS=2
GEOAI_IMPORT_TIMEOUT_MINUTES=60
# Uploaded data is kept in WGS 84 and given back in the coordinate system it came in. Some systems (older datums
# such as NAD27) convert only with grids, fetched from cdn.proj.org when first used. OFF: no internet access;
# those conversions are then less exact (metres).
GEOAI_PROJ_NETWORK=ON

# ---------------------------------------------------------------------------
# Your own database and Keycloak: only for docker-compose.external.yml.
# docker-compose.yml ignores this section and uses its own database and Keycloak.
# ---------------------------------------------------------------------------
# Any PostgreSQL 15+ with PostGIS. The database must exist; it may be empty.
GEOAI_DB_CONNECTION=Host=your-db-server;Port=5432;Database=geoai;Username=geoai_app;Password=change-me
# Optional: a user with more rights, only used to create and upgrade tables.
GEOAI_DB_MIGRATION_CONNECTION=
# false = a database administrator runs "dotnet portalapi.dll migrate" instead.
GEOAI_DB_AUTO_MIGRATE=true
# Your Keycloak as browsers see it. Import docker/keycloak/geoai-realm.json into it first.
GEOAI_KEYCLOAK_URL=https://login.example.org
GEOAI_KEYCLOAK_REALM=geoai
GEOAI_KEYCLOAK_REQUIRE_HTTPS=true
